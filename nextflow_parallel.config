conda.enabled = true
conda.useMamba = true

executor {
    name      = 'local'
    cpus      = 44          // 48 logical - 4 headroom for OS/other processes
    memory    = '440 GB'    // 454 available - ~14 GB headroom
    queueSize = 48          // generous queue, never a bottleneck
}

process {
    withName: 'runClassyfireLocal' {
        cpus      = 1        // Classyfire JAR is single-threaded
        memory    = '8 GB'   // 454 GB / 44 tasks = ~10 GB each, 8 GB is safe
        maxForks  = 44       // saturate all available logical CPUs
    }

    withName: 'prepareAndSplit' {
        cpus   = 2
        memory = '8 GB'
    }

    withName: 'mergeResults' {
        cpus   = 2
        memory = '16 GB'    // merging many large TSVs, give it headroom
    }
}